{
  "name": "agentic-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "discover": "tsx packages/dashboard-api/src/cli.ts discover",
    "bootstrap": "tsx packages/dashboard-api/src/cli.ts bootstrap",
    "review": "tsx packages/dashboard-api/src/cli.ts review",
    "install-local": "tsx packages/dashboard-api/src/cli.ts install-local",
    "discover-local": "tsx packages/dashboard-api/src/cli.ts discover-local",
    "discover:reference-store": "tsx packages/dashboard-api/src/cli.ts discover \"$AGENTIC_PLATFORM_REFERENCE_STORE_REPO\" reference-store",
    "bootstrap:reference-store": "tsx packages/dashboard-api/src/cli.ts bootstrap \"$AGENTIC_PLATFORM_REFERENCE_STORE_REPO\" reference-store",
    "review:reference-store": "tsx packages/dashboard-api/src/cli.ts review \"$AGENTIC_PLATFORM_REFERENCE_STORE_REPO\" reference-store",
    "install-local:reference-store": "tsx packages/dashboard-api/src/cli.ts install-local \"$AGENTIC_PLATFORM_REFERENCE_STORE_REPO\"",
    "discover-local:reference-store": "tsx packages/dashboard-api/src/cli.ts discover-local \"$AGENTIC_PLATFORM_REFERENCE_STORE_REPO\" reference-store",
    "verify:install-local:reference-store": "node scripts/verify-install-local-reference-store.mjs",
    "verify:real-reference-store": "node scripts/verify-real-reference-store.mjs",
    "verify:generic-frontend": "node scripts/verify-generic-frontend.mjs",
    "verify:generic-repository-types": "node scripts/verify-generic-repository-types.mjs",
    "verify:generic-runtime-execution": "node scripts/verify-generic-runtime-execution.mjs",
    "verify:domain-discovery-contracts": "node scripts/verify-domain-discovery-contracts.mjs",
    "verify:static-frontend-scanner": "node scripts/verify-static-frontend-scanner.mjs",
    "verify:domain-fixture-matrix": "node scripts/verify-domain-fixture-matrix.mjs",
    "verify:domain-specialist-service": "node scripts/verify-domain-specialist-service.mjs",
    "verify:l5": "node scripts/verify-l5.mjs",
    "verify:l5:soak": "node scripts/verify-l5-soak.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "dev:api": "tsx packages/dashboard-api/src/server.ts",
    "dev:web": "tsx packages/dashboard-web/src/server.ts",
    "build": "echo 'scaffold only'",
    "dev": "echo 'run npm run dev:api and npm run dev:web in separate terminals'"
  }
}
